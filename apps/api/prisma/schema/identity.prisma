// Schema cho module identity (RBAC, tài khoản, phiên, consent, audit log).

enum UserKind {
  customer
  staff
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  emailVerified  Boolean         @default(false)
  passwordHash   String?
  name           String?
  phone          String?
  kind           UserKind
  lockedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          UserRole[]
  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  emailTokens    EmailToken[]
  consentRecords ConsentRecord[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  provider       String
  providerUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum EmailTokenPurpose {
  verify
  reset
  invite
}

model EmailToken {
  id        String            @id @default(uuid())
  tokenHash String            @unique
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@map("email_tokens")
}

model ConsentRecord {
  id              String   @id @default(uuid())
  anonymousId     String
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  personalization Boolean  @default(false)
  marketing       Boolean  @default(false)
  policyVersion   String
  createdAt       DateTime @default(now())

  @@index([anonymousId])
  @@index([userId])
  @@map("consent_records")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
