# Sao chép thành .env rồi điền giá trị thật. Không commit .env.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Số hop proxy tin cậy, hoặc danh sách IP và subnet. Giá trị false bỏ qua X-Forwarded-For.
TRUST_PROXY=false

# Đường dẫn tới index.html đã build của web, ví dụ apps/frontend/dist/index.html.
# API chèn thẻ meta SEO vào file này cho /p/{slug} và /c/{slug}. Để trống thì hai route đó không được gắn.
WEB_INDEX_HTML_PATH=

# Để trống thì API dùng giá trị giả, và đăng nhập Google không chạy thật.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Thư mục lưu thư ở môi trường dev. Để trống thì API dùng .dev-outbox trong thư mục chạy API.
DEV_OUTBOX_DIR=

# DB dev và DB test tách riêng (xem docker-compose.yml).
DATABASE_URL=postgresql://pickory:pickory@localhost:5432/pickory
TEST_DATABASE_URL=postgresql://pickory:pickory@localhost:5432/pickory_test
# Để trống để dùng connection dev với tên DB riêng pickory_e2e.
# E2E không dùng DB dev hoặc DB integration.
E2E_DATABASE_URL=
# Số kết nối DB tối đa của API, từ 1 đến 100. Để trống thì dùng mặc định của Npgsql (100).
# Đặt khi DB giới hạn kết nối, ví dụ Supabase Session pooler gói free cho 15 kết nối.
DATABASE_POOL_MAX=

# Không có khóa trong dev thì gateway dùng fake provider, production không dùng fake.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# Điền ID model được xác nhận, ví dụ deepseek-flash, trước khi bật provider thật.
LLM_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
AI_MONTHLY_BUDGET_USD=30
AI_CHAT_DAILY_LIMIT_USER=50
AI_CHAT_DAILY_LIMIT_ANON=15
# Chỉ bật khi đã có khóa thật, các contract test này phát sinh chi phí.
AI_LIVE_TESTS=0

# Khóa Cloudinary cho ảnh sản phẩm. Điền đủ cả ba hoặc để trống cả ba.
# Để trống ở dev và test thì API dùng kho ảnh giả. Production thiếu khóa thì API dừng khi khởi động.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Giao hàng qua GHN. Để trống ở dev và test thì API dùng client GHN giả.
# Production thiếu GHN_TOKEN, GHN_SHOP_ID hoặc GHN_WEBHOOK_SECRET thì API dừng khi khởi động.
# Mặc định GHN_API_BASE là sandbox. Production đổi sang https://online-gateway.ghn.vn.
GHN_API_BASE=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=
# Đặt 1 để chạy test gọi sandbox GHN thật. Chỉ nhận 0 hoặc 1.
GHN_LIVE_TESTS=0

# Đặt 1 để production có tài liệu API chỉ xem tại /api/docs. Chỉ nhận 0 hoặc 1.
# Development luôn có tài liệu, kèm nút "Try it out". Tài liệu liệt kê cả route admin, nên mặc định tắt.
API_DOCS_ENABLED=0
