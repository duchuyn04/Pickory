# Mẫu `.env` cho VPS. Sao chép thành `.env` ở thư mục chạy compose rồi điền giá trị thật.
# Không commit file `.env`.

# Domain công khai, không có `https://`.
SITE_DOMAIN=pickory.tech

# Mật khẩu DB. Dùng chuỗi chữ và số (ví dụ `openssl rand -hex 24`) để không phải mã hóa URL.
POSTGRES_PASSWORD=

# Ứng dụng OAuth của Google. Redirect URI: https://pickory.tech/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary cho ảnh sản phẩm. Điền đủ cả ba. Production thiếu khóa thì API dừng khi khởi động.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Giao hàng GHN. Sandbox: https://dev-online-gateway.ghn.vn. Production: https://online-gateway.ghn.vn.
GHN_API_BASE=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=

# Khóa SePay gửi kèm webhook tiền về. Production thiếu khóa thì API dừng khi khởi động.
SEPAY_WEBHOOK_API_KEY=

# 1 để mở tài liệu API tại /api/docs. Đặt API_DOCS_INTERACTIVE=1 để có nút "Try it out".
API_DOCS_ENABLED=1
API_DOCS_INTERACTIVE=1
