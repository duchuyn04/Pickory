{
  "name": "pickory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:web": "pnpm --filter @pickory/frontend dev",
    "dev:api": "dotnet run --project apps/backend-dotnet/src/Pickory.Api",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "dotnet:build": "dotnet build apps/backend-dotnet/Pickory.sln",
    "dotnet:test": "dotnet test apps/backend-dotnet/Pickory.sln",
    "dotnet:dev": "dotnet run --project apps/backend-dotnet/src/Pickory.Api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
